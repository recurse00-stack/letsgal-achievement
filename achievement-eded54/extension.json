{
  "id": "achievement-eded54",
  "name": "成就",
  "description": "最简成就：分级、图标名称、激活状态、自定义 UI 与浮现动画",
  "author": "mixing-entropy",
  "version": "0.1.0",
  "entry": "dist/index.js",
  "studioEntry": "dist/studio.js",
  "sdkVersion": "^2.8.0-beta.1",
  "dataDependencies": {
    "states": {
      "contract": "letsgal.achievement.states",
      "version": "^1.0.0",
      "name": "成就激活记录",
      "description": "同一玩家档案内跨存档共享的成就激活事实；读旧档不回退，每个 achievementId 唯一。",
      "access": "runtime-write",
      "optional": false,
      "autoCreate": {
        "name": "成就激活记录",
        "contractVersion": "1.0.0",
        "runtimePolicy": "profile",
        "schema": {
          "type": "object",
          "properties": {
            "achievementId": {
              "type": "string"
            },
            "active": {
              "type": "boolean"
            }
          },
          "required": [
            "achievementId",
            "active"
          ],
          "additionalProperties": true,
          "columns": [
            {
              "key": "achievementId",
              "label": "成就编号",
              "type": "text"
            },
            {
              "key": "active",
              "label": "激活",
              "type": "boolean",
              "default": false
            }
          ],
          "titleColumn": "achievementId"
        },
        "documents": []
      }
    }
  }
}
